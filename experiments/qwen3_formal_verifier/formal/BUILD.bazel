    name = "formal_smoke_tests",
    tests = [
        ":lean_smoke_test",
        ":tlc_smoke_test",
    ],
)

# Tier 0: the trace-free checks. Every target here reads only hand-written
# sources, so it runs on CPU without a generated facts module, a GPU or an
# attempt bundle. Minutes rather than seconds: tlc_device_mesh_model_test runs
# eleven checks over eight communicators, and lean_device_mesh_protocol_test carries
# the quantified protocol theorems, which mention no trace and no bound. This
# suite is for iteration and is not a gate: no attempt bundle is sealed from
# it.
test_suite(
    name = "tier0_formal_tests",
    tests = [
        ":lean_device_mesh_protocol_test",
        ":lean_smoke_test",
        ":tlc_single_rank_model_abstract_test",
        ":tlc_device_mesh_model_test",
        ":tlc_smoke_test",
    ],
)

