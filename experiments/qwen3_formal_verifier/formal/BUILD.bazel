# Tier 0: the trace-free checks. Every target here reads only hand-written
# sources, so it runs on CPU without a generated facts module, a GPU or an
# attempt bundle. Minutes rather than seconds: tlc_scout_b_model_test runs seven
# TLC searches over eight communicators. This suite is for iteration and is not
# a gate: no attempt bundle is sealed from it.
test_suite(
    name = "tier0_formal_tests",
    tests = [
        ":lean_smoke_test",
        ":tlc_scout_a_model_abstract_test",
        ":tlc_scout_b_model_test",
        ":tlc_smoke_test",
    ],
)

